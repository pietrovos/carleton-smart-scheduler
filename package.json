{
  "name": "carleton-smart-scheduler",
  "version": "0.1.0",
  "description": "Smart Scheduler for Carleton Engineering Students",
  "scripts": {
    "dev": "sh -c 'npm run dev:server & server_pid=$!; npm run dev:client; kill $server_pid'",
    "dev:client": "npm --prefix Carletonscheduler run dev",
    "dev:server": "npm run server",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate && cd Carletonscheduler && npm install && npm run build",
    "db:setup": "prisma generate && prisma db push",
    "db:reset": "prisma db push --force-reset",
    "db:seed": "tsx scripts/seed.ts",
    "user:create": "tsx scripts/create-user.ts",
    "db:import-timetable": "tsx scripts/import-timetable.ts",
    "test:unit": "node --import tsx --test tests/**/*.test.ts",
    "validate:data": "node --import tsx scripts/validate-schedule-data.ts",
    "benchmark:schedules": "node --import tsx scripts/benchmark-schedules.ts",
    "cli": "tsx cli/index.ts",
    "server": "tsx watch server/index.ts",
    "server:build": "tsc -p tsconfig.server.json",
    "server:start": "node dist/server/index.js"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "pdfreader": "^3.0.8",
    "prisma": "^5.7.0",
    "typescript": "^5.0.0"
  },
  "devDependencies": {
    "@types/cheerio": "^1.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.0.0",
    "tsx": "^4.6.0"
  }
}
